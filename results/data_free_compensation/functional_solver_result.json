  "independent_validation_source": "import hashlib,json,math\nfrom pathlib import Path\nimport numpy as np\nimport torch\nfrom _impl.data import official_labels\nroot=Path(\"outputs/functional_solver_20261026\")\nout=root/\"native\"\nmeta=json.loads((out/\"results.json\").read_text())\nassert hashlib.sha256((out/\"full.pt\").read_bytes()).hexdigest()==meta[\"rows\"][0][\"raw_sha256\"]\nd=torch.load(out/\"full.pt\",map_location=\"cpu\",weights_only=False)\na,b=[d[k].double().numpy() for k in [\"before\",\"after\"]]\ny=official_labels(\"MNIST\",False)[d[\"indices\"]]\nnp.testing.assert_array_equal(d[\"indices\"],np.arange(10000));np.testing.assert_array_equal(y,d[\"labels\"])\npa,pb=a.argmax(1),b.argmax(1);ca,cb=pa==y,pb==y\nlost=int(np.sum(ca&~cb));gained=int(np.sum(~ca&cb));n=len(y)\ndelta=cb.astype(float)-ca.astype(float);mean=float(delta.mean());se=float(delta.std(ddof=1)/math.sqrt(n))\nm=lost+gained;k=min(lost,gained)\nterms=np.array([math.lgamma(m+1)-math.lgamma(j+1)-math.lgamma(m-j+1)-m*math.log(2) for j in range(k+1)])\nlogp=min(0.,float(np.logaddexp.reduce(terms))+math.log(2)) if m else 0.\nstats=dict(status=\"passed_independent_numpy_native_counts\",before_correct=int(ca.sum()),after_correct=int(cb.sum()),\n n=n,changed_predictions=int(np.sum(pa!=pb)),lost=lost,gained=gained,\n paired_accuracy_delta_95ci_pp=[100*(mean-1.96*se),100*(mean+1.96*se)],mcnemar_log10_p=logp/math.log(10),\n per_class=[dict(class_id=i,n=int(np.sum(y==i)),before_correct=int(np.sum(ca&(y==i))),after_correct=int(np.sum(cb&(y==i))),\n lost=int(np.sum(ca&~cb&(y==i))),gained=int(np.sum(~ca&cb&(y==i)))) for i in range(10)],\n prediction_class_counts=np.bincount(pb,minlength=10).tolist(),new_image_forwards=0,new_AGA_calls=0)\nassert stats[\"after_correct\"]==meta[\"rows\"][0][\"after_correct\"] and stats[\"before_correct\"]==meta[\"rows\"][0][\"before_correct\"]\nx=dict(native={},independent_numpy_native=stats)\nfor p in sorted(out.glob(\"*.json\")):\n x[\"native\"][p.name]=json.loads(p.read_text());x[\"native\"][p.name+\"_sha256\"]=hashlib.sha256(p.read_bytes()).hexdigest()\nraw=torch.load(root/\"source_scores.pt\",map_location=\"cpu\",weights_only=False)\naa,bb=[raw[k].double().numpy()/4 for k in [\"before\",\"after\"]]\naa-=np.logaddexp.reduce(aa,axis=1,keepdims=True);bb-=np.logaddexp.reduce(bb,axis=1,keepdims=True)\nKL=float(16*np.mean(np.sum(np.exp(aa)*(aa-bb),axis=1)))\nsource_meta=json.loads((root/\"results.json\").read_text());assert abs(KL-source_meta[\"final_KL\"])<1e-5\nx[\"independent_numpy_source\"]=dict(KL=KL,agreement=int(np.sum(raw[\"before\"].argmax(1).numpy()==raw[\"after\"].argmax(1).numpy())),\n scalar_KL_error=abs(KL-source_meta[\"final_KL\"]),source_scores_sha256=hashlib.sha256((root/\"source_scores.pt\").read_bytes()).hexdigest(),new_image_forwards=0)\n(root/\"independent_complete.json\").write_text(json.dumps(x,indent=2)+\"\\n\")\nprint(json.dumps(dict(native=stats,source=x[\"independent_numpy_source\"])))\n",
