    "source_sha256": "8472abd3eceb182bc5262fc5a79125f10774801dabe037e7fdf6dd4bc02809a9",
    "calculation_source": "\"\"\"Read-only QK/OV product drift;not task accuracy or a new defense.\"\"\"\nimport json,time,torch,numpy as np\nfrom _impl.models import initialize,load_checkpoint\nfrom _impl.io import digest\ninitialize()\nstart=time.monotonic()\nexpert=load_checkpoint(\"MNIST/finetuned.pt\").state_dict()\nbase=load_checkpoint(\"zeroshot.pt\").state_dict()\nrows=[]\ncheck=0.0\nfor layer in range(12):\n p=f\"model.visual.transformer.resblocks.{layer}.attn.\"\n qe,ke,ve=expert[p+\"in_proj_weight\"].double().cuda().chunk(3)\n qb,kb,vb=base[p+\"in_proj_weight\"].double().cuda().chunk(3)\n oe=expert[p+\"out_proj.weight\"].double().cuda()\n ob=base[p+\"out_proj.weight\"].double().cuda()\n for h in range(12):\n  s=slice(h*64,(h+1)*64)\n  for name,le,re,lb,rb in [\n   (\"QK\",qe[s].T,ke[s],qb[s].T,kb[s]),\n   (\"OV\",oe[:,s],ve[s],ob[:,s],vb[s])]:\n   me,mb=le@re,lb@rb\n   delta=(me-mb).norm()\n   if layer==11 and h==0:\n    x=le.cpu().numpy()@re.cpu().numpy()\n    y=lb.cpu().numpy()@rb.cpu().numpy()\n    direct=np.linalg.norm(x-y)/np.linalg.norm(x)\n    check=max(check,abs(float(delta/me.norm())-float(direct)))\n   rows.append(dict(layer=layer,head=h,circuit=name,\n     expert_frobenius=float(me.norm()),\n     anchor_frobenius=float(mb.norm()),\n     difference_frobenius=float(delta),\n     relative_to_expert=float(delta/me.norm())))\nresult=dict(target=\"MNIST\",heads=144,circuit_rows=len(rows),rows=rows,\n numpy_fixed_last_head_max_relative_metric_difference=check,\n real_images=0,new_defense_points=0,new_AGA_calls=0,expert_updates=0,\n source_hashes={p:digest(p) for p in [\"_impl/models.py\",\"configs/checkpoints.json\"]},\n checkpoint_hashes={p:digest(\"checkpoints/ViT-B-32/\"+p) for p in [\"MNIST/finetuned.pt\",\"zeroshot.pt\"]},\n seconds=time.monotonic()-start,\n scope=\"Raw weight products only;bias,LN,softmax,MLP,downstream margin and classification are not represented by these Frobenius ratios.\")\nresult[\"summary\"]={}\nfor circuit in [\"QK\",\"OV\"]:\n values=np.array([r[\"relative_to_expert\"] for r in rows if r[\"circuit\"]==circuit])\n result[\"summary\"][circuit]=dict(minimum=float(values.min()),median=float(np.median(values)),maximum=float(values.max()))\nprint(json.dumps(result))\n",
