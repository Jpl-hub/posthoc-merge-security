    "source": "import ast,hashlib,json,math,time\nfrom pathlib import Path\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nfrom _impl.models import initialize,load_checkpoint\nfrom _impl.io import digest\ninitialize();start=time.monotonic()\nout=Path(\"outputs/nonlinear_task_condition_20261026\");out.mkdir(exist_ok=False)\nexpert=load_checkpoint(\"MNIST/finetuned.pt\");state=expert.state_dict()\nref=Path(\"outputs/phase2_task_subspace_comparison_20261020/basis.pt\")\nassert digest(ref)==\"99b5f25e7868dd8fd1e9712cf2cca37600f470e8345f5782869e9a0d67d71344\"\nentries={r[\"source_key\"]:r for r in torch.load(ref,map_location=\"cpu\",weights_only=False).values()}\nphi=lambda z:z*torch.sigmoid(1.702*z)\neven=lambda z:.5*z*torch.tanh(.851*z)\nrows=[]\nfor i in range(12):\n p=f\"model.visual.transformer.resblocks.{i}.\"\n A,B,a,b=[state[p+\"mlp.\"+k].double().cuda() for k in [\"c_fc.weight\",\"c_proj.weight\",\"c_fc.bias\",\"c_proj.bias\"]]\n ba,bb=[entries[p+\"mlp.\"+k+\".weight\"] for k in [\"c_fc\",\"c_proj\"]]\n ua,va,vb=[v.cuda() for v in [ba[\"u\"],ba[\"v\"],bb[\"v\"]]]\n columns=torch.cat([ua,A@va,vb,a[:,None]],dim=1)\n columns=columns[:,columns.norm(dim=0)>0];columns/=columns.norm(dim=0)\n C,s,_=torch.linalg.svd(columns,full_matrices=False);C=C[:,s>s[0]*1e-10]\n reflect=lambda z:2*C@(C.T@z)-z\n Ap=reflect(A);Bt=2*(B@C)@C.T-B\n r=torch.cat([va.T,-va.T]);r-=r.mean(1,keepdim=True);r*=math.sqrt(768)/r.norm(dim=1,keepdim=True)\n gamma,beta=[state[p+\"ln_2.\"+k].double().cuda() for k in [\"weight\",\"bias\"]]\n eps=expert.model.visual.transformer.resblocks[i].ln_2.eps\n X=F.layer_norm(r,(768,),gamma,beta,eps)\n pairs=va.T+torch.roll(va.T,-1,0)\n mixed=torch.cat([pairs,-pairs]);mixed-=mixed.mean(1,keepdim=True);mixed*=math.sqrt(768)/mixed.norm(dim=1,keepdim=True)\n Xm=F.layer_norm(mixed,(768,),gamma,beta,eps)\n Xall=torch.cat([X,Xm])\n z=F.linear(Xall,A,a).T\n original=B@phi(z)\n changed=Bt@phi(F.linear(Xall,Ap,a)).T\n derived=B@(reflect(even(reflect(z)))-even(z))\n identity=float((changed-original-derived).norm()/(1+original.norm()))\n linear_error=float((Bt@(Ap@Xall.T+a[:,None])-B@z).norm()/(1+(B@z).norm()))\n assert identity<1e-10 and linear_error<1e-10\n # Exact finite joint constraints use quantized A and the same machine-epsilon inverse.\n Aq=Ap.float().double();Btemplate=Bt.float().double()\n H=phi(F.linear(X,Aq,a)).T;Y=B@phi(F.linear(X,A,a)).T\n U,s,vh=torch.linalg.svd(H,full_matrices=False);keep=s>torch.finfo(torch.double).eps*max(H.shape)*s[0]\n inverse=(vh[keep].T/s[keep])@U[:,keep].T\n Bfit=Btemplate+(Y-Btemplate@H)@inverse\n axis_error=float((Bfit@H-Y).norm()/(1+Y.norm()))\n Hm=phi(F.linear(Xm,Aq,a)).T;Ym=B@phi(F.linear(Xm,A,a)).T\n mix_error=float((Bfit@Hm-Ym).norm()/(1+Ym.norm()))\n # In the raw task-input span, A changes zero; the paired B error is still an even-part term.\n raw=torch.cat([va.T,-va.T])*math.sqrt(768)\n zr=F.linear(raw,A,a).T\n task_A_error=float(((Ap-A)@raw.T).norm()/(1+(A@raw.T).norm()))\n raw_delta=Bt@phi(F.linear(raw,Ap,a)).T-B@phi(zr)\n raw_pred=-2*B@(even(zr)-C@(C.T@even(zr)))\n raw_identity=float((raw_delta-raw_pred).norm()/(1+(B@phi(zr)).norm()))\n assert task_A_error<1e-10 and raw_identity<1e-10\n row=dict(layer=i,linear_paired_response_relative_error=linear_error,\n          even_decomposition_identity_error=identity,\n          paired_nonlinear_output_relative_error=float((changed-original).norm()/(1+original.norm())),\n          joint_axis_output_relative_error=axis_error,\n          joint_mixed_output_relative_error=mix_error,\n          raw_task_A_relative_error=task_A_error,raw_task_even_identity_error=raw_identity,\n          raw_task_paired_output_relative_error=float(raw_delta.norm()/(1+(B@phi(zr)).norm())),\n          raw_task_even_hidden_complement_energy=float(\n              (even(zr)-C@(C.T@even(zr))).square().sum()/even(zr).square().sum()))\n if i in [0,11]:\n  aa,bb,aa0,cc,xx=[v.cpu().numpy() for v in [A,B,a,C,Xall]]\n  zz=aa@xx.T+aa0[:,None]\n  R=lambda v:2*cc@(cc.T@v)-v\n  ph=lambda v:v/(1+np.exp(-1.702*v))\n  ee=lambda v:.5*v*np.tanh(.851*v)\n  actual=(2*(bb@cc)@cc.T-bb)@ph(R(zz))-bb@ph(zz)\n  reference=bb@(R(ee(R(zz)))-ee(zz))\n  row[\"independent_numpy_identity_error\"]=float(np.linalg.norm(actual-reference)/(1+np.linalg.norm(bb@ph(zz))))\n  row[\"numpy_torch_delta_error\"]=float(np.linalg.norm(actual-(changed-original).cpu().numpy())/(1+np.linalg.norm(actual)))\n  assert row[\"independent_numpy_identity_error\"]<1e-10 and row[\"numpy_torch_delta_error\"]<1e-10\n rows.append(row);print(\"NONLINEAR_TASK\",json.dumps(row),flush=True)\nresult=dict(status=\"original_weight_nonlinear_response_condition\",rows=rows,basis_sha256=digest(ref),\n source_images=0,new_real_images=0,new_defense_points=0,new_AGA_calls=0,parameter_updates=0,\n local_layer_vector_inputs=2304,seconds=time.monotonic()-start,\n scope=\"Known even-linear activation decomposition applied to the unchanged original-weight reflection family. Signed axes and fixed neighboring sums only; no direction/rank/strength selection or published-model repair. Not a natural-task distribution or impossibility claim. RawVa inputs are algebraic probes,not necessarily validLN;LN-compatible probes are reported separately.\")\n(out/\"results.json\").write_text(json.dumps(result,indent=2)+\"\\n\")\nprint(\"NONLINEAR_TASK_DONE\",result[\"seconds\"],flush=True)\n",
